{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dl",
      "destination": "https://github.com/TomShi11/douyin-spark-keeper/releases/latest/download/douyin-spark-keeper.zip",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/TomShi11/douyin-spark-keeper",
      "permanent": false
    }
  ]
}
